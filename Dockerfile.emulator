# FROM python:3.12
FROM python:3.12 as base

# Install prerequisites
RUN apt-get update && \
    apt-get install -y curl default-jre libmagic-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Node.js v18 using NodeSource and npm
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get update && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Now npm should be available
RUN npm install -g firebase-tools

# Set working directory
WORKDIR /app

# Copy ONLY requirements first to leverage Docker cache
COPY functions/requirements.txt /app/functions/requirements.txt

# Install Python dependencies
WORKDIR /app/functions
RUN python -m venv venv && \
    . venv/bin/activate && \
    pip install --no-cache-dir -r requirements.txt

# Back to app directory
WORKDIR /app
COPY functions /app/functions

# Copy other necessary files
COPY firebase.json ./
COPY docker-entrypoint.sh /app/docker-entrypoint.sh


# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV FIREBASE_DEBUG=true
ENV OPENAI_API_DISABLE_EMBEDDING_CACHE=true

# Expose ports
EXPOSE 4000 4400 5001 8080 9150

# Mount volumes at runtime
VOLUME ["/app/functions"]

RUN chmod +x /app/docker-entrypoint.sh
# Set entrypoint
ENTRYPOINT ["/app/docker-entrypoint.sh"]