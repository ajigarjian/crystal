{
  "hosting": {
    "source": "frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "us-central1"
    }
  },
  "functions": {
    "source": "functions",
    "runtime": "python312",
    "timeoutSeconds": 300,
    "memory": "512MB",
    "ignore": [
      "venv",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local",
      "__pycache__",
      "*.pyc"
    ],
    "predeploy": [
      "pip install -r functions/requirements.txt"
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001,
      "timeoutSeconds": 300
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    }
  }
}
